# Copy to .env and fill in. Never commit .env.

# --- Snowflake (use a read-only role) ---
# SNOWFLAKE_PASSWORD can be a programmatic access token (the user needs a network policy for that)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1

# --- Model (open-weight, hosted on Snowflake Cortex) ---
CORTEX_MODEL=llama3.1-8b

# --- Harness / execution limits ---
MAX_ATTEMPTS=3
ROW_LIMIT=100
QUERY_TIMEOUT_S=30
# Ask the model to judge its own result (off: small models reject correct queries too often)
LLM_CRITIQUE=false
# Candidate queries the full harness writes before keeping the majority result (1 = no vote)
VOTE_CANDIDATES=3

# --- API ---
FRONTEND_ORIGIN=http://localhost:5173
