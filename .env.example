# Copy to .env and fill in. Never commit .env.

# --- Snowflake (use a read-only role) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1

# --- Model (Snowflake Cortex COMPLETE) ---
# Must be open-weight and <=10B params. Check it runs in your region:
#   SELECT SNOWFLAKE.CORTEX.COMPLETE('llama3.1-8b', 'hi');
CORTEX_MODEL=llama3.1-8b

# --- Harness / execution limits ---
MAX_ATTEMPTS=3
ROW_LIMIT=100
QUERY_TIMEOUT_S=30

# --- API ---
FRONTEND_ORIGIN=http://localhost:5173
